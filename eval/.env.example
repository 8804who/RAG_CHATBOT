# Copy to .env and adjust as needed.
# Infra + backend must already be running (see repo root CLAUDE.md); the
# Postgres values below match docker.env's defaults.

API_BASE_URL=http://localhost:8000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=rag_chatbot

# Which fixtures/v2/<name>.json to run: comma list of ko-rag, en-rag,
# ko-nonrag, en-nonrag, tool — or all.
EVAL_DATASET=all
# Fixture directory (relative to eval/ or absolute). Default fixtures/v2.
# EVAL_FIXTURES_DIR=fixtures/v2
# Chat model every case's chat is created with (must be registered in the backend).
CHAT_MODEL=gpt-4o-mini

# RAG-case retrieval thresholds when a case doesn't set minRecall / minPrecision.
# Recall is document-level recall@k; keep precision calibrated to corpus size
# vs. DEFAULT_RETRIEVAL_TOP_K (8) — see the README note.
MIN_RECALL=1
MIN_PRECISION=0.3

# LLM-as-judge: grades the chatbot's actual answer against each case's
# expectedAnswer. Separate from the backend's own OPENAI_API_KEY — this one
# is used directly by the test runner (src/judge.ts), so it can be the same
# key as backend/app/.env or a different one (e.g. a lower-spend key).
OPENAI_API_KEY=
# Default gpt-6.2-sol (stronger than the chat models under test). Override here.
# JUDGE_MODEL=gpt-6.2-sol
# Minimum judge correctness (0.0-1.0) a case must hit when it doesn't set its
# own minJudgeScore.
MIN_JUDGE_SCORE=0.6

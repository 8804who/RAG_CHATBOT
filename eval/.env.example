# Copy to .env and adjust as needed.
# Infra + backend must already be running (see repo root CLAUDE.md); the
# Postgres values below match docker.env's defaults.

API_BASE_URL=http://localhost:8000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=rag_chatbot

# Minimum retrieval precision a golden case must hit when it doesn't set its
# own minPrecision in fixtures/golden-dataset.json. Keep this calibrated to
# your corpus size vs. DEFAULT_RETRIEVAL_TOP_K (8) — see the README note.
MIN_PRECISION=0.3

# LLM-as-judge: grades the chatbot's actual answer against each case's
# expectedAnswer. Separate from the backend's own OPENAI_API_KEY — this one
# is used directly by the test runner (src/judge.ts), so it can be the same
# key as backend/app/.env or a different one (e.g. a lower-spend key).
OPENAI_API_KEY=
JUDGE_MODEL=gpt-4o-mini
# Minimum judge score (0.0-1.0) a case must hit when it doesn't set its own
# minJudgeScore in fixtures/golden-dataset.json.
MIN_JUDGE_SCORE=0.6
